{
    "dependencies": {
        "react": "^19.2.6",
        "react-dom": "^19.2.6"
    },
    "devDependencies": {
        "esbuild": "^0.28.0"
    },
    "scripts": {
        "build": "esbuild src/main.jsx --bundle --minify --sourcemap --outfile=dist/main.js --jsx=automatic",
        "serve": "npx serve dist",
        "dev": "esbuild src/main.jsx --bundle --minify --sourcemap --outfile=dist/main.js --jsx=automatic --servedir=./dist --watch"
    }
}
